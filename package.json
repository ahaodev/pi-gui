{
  "name": "pi-gui",
  "private": true,
  "version": "0.1.0-beta.34",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "dev": "pnpm --filter @pi-gui/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @pi-gui/session-driver build && pnpm --filter @pi-gui/catalogs build && pnpm --filter @pi-gui/pi-sdk-driver build && pnpm -r --if-present typecheck",
    "package:win": "pnpm --filter @pi-gui/desktop run package:win",
    "package:win:dir": "pnpm --filter @pi-gui/desktop run package:win:dir",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "e2e": "playwright test",
    "test:homebrew-tap": "node scripts/test-update-homebrew-tap.mjs",
    "test:release-helpers": "node --test apps/desktop/scripts/release-artifacts.test.mjs apps/desktop/scripts/github-release-state.test.mjs apps/desktop/scripts/verify-linux-release.test.mjs scripts/verify-release-version.test.mjs",
    "verify:install-copy": "node scripts/verify-install-copy.mjs",
    "verify:release-config": "node apps/desktop/scripts/verify-release-config.mjs",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "verify:homebrew-flow": "node scripts/verify-homebrew-flow.mjs",
    "release:homebrew-sync": "node scripts/release-homebrew-sync.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.0.0",
    "pnpm": "11.24.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "video"
  ]
}
